APP_NAME="NIVICO Electronic Mart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nivico
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=mail.nivico.id
MAIL_PORT=465
MAIL_USERNAME=noreply@nivico.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@nivico.id"
MAIL_FROM_NAME="NIVICO Electronic Mart"

# Toko
SHOP_FREE_SHIPPING_MIN=150000
SHOP_DEFAULT_ONGKIR=15000

# ── RajaOngkir / Komerce ──
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN=
RAJAONGKIR_ORIGIN_TYPE=city
RAJAONGKIR_COURIERS=jne:sicepat:jnt
RAJAONGKIR_DEFAULT_WEIGHT=1000

# ── Midtrans Production ──
# Ambil Production Access Keys dari dashboard Midtrans, bukan Sandbox keys.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true

# ── Duitku legacy ──
# Pertahankan hanya selama masih ada transaksi Duitku lama yang pending.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false
DUITKU_EXPIRY_PERIOD=60
